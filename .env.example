# 复制为 .env 并填写本机配置；不要提交包含真实密钥的 .env。

# 本地 Compose 开发认证令牌。请运行以下命令生成新值：
# Keep this aligned with the tenant used by the local review workers.
AUTH_TENANT_ID=00000000-0000-4000-8000-000000000001

# 合同审查 Worker 使用的模型（兼容 OpenAI API 的服务端点）。
CONTRACT_REVIEW_MODEL=deepseek-flash
CONTRACT_REVIEW_MODEL_API_KEY=
LEGAL_SEARCH_API_KEY=
LEGAL_SEARCH_PROVIDER=auto
CONTRACT_REVIEW_MODEL_BASE_URL=https://api.deepseek.com

# 必须与此 Worker 要处理的案件/运行记录的 tenant_id 一致。
# 这是本地 Compose 固定使用的租户；处理其他数据时请改为对应的租户 UUID。
CONTRACT_REVIEW_TENANT_ID=00000000-0000-4000-8000-000000000001
DOCUMENT_PARSE_TENANT_ID=00000000-0000-4000-8000-000000000001
DOCUMENT_INDEX_TENANT_ID=00000000-0000-4000-8000-000000000001

# 本机运行命令连接共享 infra PostgreSQL 的项目专属数据库。
# 使用项目 Compose 容器时，Compose 当前仍连接其自己的 contract_audit 数据库。
DATABASE_URL=postgresql://dev:dev_local_only@localhost:5432/contract_agent
DATABASE_ADMIN_URL=postgresql://dev:dev_local_only@localhost:5432/contract_agent
# 当前测试环境复用 contract_agent；运行测试可能写入或清理其中的数据。
TEST_DATABASE_URL=postgresql://dev:dev_local_only@localhost:5432/contract_agent
TEST_ADMIN_DATABASE_URL=postgresql://dev:dev_local_only@localhost:5432/contract_agent

# 本机开发/测试可显式启动审核；生产环境始终拒绝此开发审查入口。
APP_ENV=development
CONTRACT_REVIEW_EXECUTION_ENABLED=true
