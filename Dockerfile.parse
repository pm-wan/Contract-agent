FROM python:3.13-slim@sha256:8d9d0b8bcf6506481eae4907c18f5e3e7902e629f5f6d684f9e7c32e85e3ddf0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/workspace/src \
    PATH=/opt/venv/bin:$PATH \
    DOCX_RENDERER_EXPECTED_VERSION=25.2.3 \
    DOCX_RENDERER_ENVIRONMENT_ID=deb13-noto-cjk-20240730

WORKDIR /workspace
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-writer-nogui=4:25.2.3-2+deb13u8 \
       fonts-noto-cjk=1:20240730+repack1-1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock README.md ./
COPY src ./src

RUN uv sync --frozen --no-dev --no-install-project --extra database --extra telemetry

CMD ["python", "-m", "contract_app.documents.parse_worker"]
