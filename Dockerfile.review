FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /workspace
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /uvx /bin/

COPY pyproject.toml uv.lock README.md ./
COPY alembic.ini ./
COPY migrations ./migrations
COPY src ./src
COPY docs/development/06-rules ./docs/development/06-rules
COPY skills/cn-procurement-contract-audit ./skills/cn-procurement-contract-audit

RUN uv sync --frozen --no-dev --extra ai --extra pageindex --extra database --extra storage --extra telemetry --no-install-package PyPDF2
